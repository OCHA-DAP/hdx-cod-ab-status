---
import type { YearStat } from "../lib/loadData.ts";
import { statusClass, STATUS_TERMS } from "../lib/status.ts";
import Term from "./Term.astro";
import type { TermSlug } from "../lib/glossary.ts";

interface Props {
  yearStats: YearStat[];
  latestYear: string;
}

const { yearStats, latestYear } = Astro.props;
---

<style>
  /* ── Cycle overview grid ─────────────────────────────────────── */
  .cycle-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .cycle-card {
    border-radius: 3px;
    border: 1px solid #cccccc;
    padding: 1rem 1.25rem;
    background: #fff;
  }

  .cycle-card.current {
    border-color: #007ce0;
    background: #edf6fd;
  }

  .cycle-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .cycle-year {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .cycle-tag {
    font-size: 0.75rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* ── Stat cards ─────────────────────────────────────────────── */
  .stat-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stat-card {
    flex: 1 1 90px;
    border-radius: 3px;
    padding: 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border: 1px solid transparent;
  }

  .stat-num {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .stat-lbl {
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #444;
  }

  .stat-card.s-done {
    background: #c6efce;
    border-color: #93d09a;
  }
  .stat-card.s-in_progress {
    background: #fff2cc;
    border-color: #f5d262;
  }
  .stat-card.s-blocked {
    background: #fce4d6;
    border-color: #f4b183;
  }
  .stat-card.s-selected {
    background: #e0f2fe;
    border-color: #7dd3fc;
  }
  .stat-card.s-backlog {
    background: #f3f4f6;
    border-color: #d1d5db;
  }
  .stat-card.s-cancelled {
    background: #ffc7ce;
    border-color: #f09098;
  }
  .cycle-total {
    font-size: 12px;
    color: #888888;
    background: #eeeeee;
    border: 1px solid #cccccc;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>

<div class="cycle-grid">
  {
    yearStats.map((ys) => {
      const isCurrent = ys.year === latestYear;
      return (
        <div class={`cycle-card ${isCurrent ? "current" : "backlog-card"}`}>
          <div class="cycle-header">
            <span class="cycle-year">{ys.year}</span>
            <span class="cycle-tag">
              {isCurrent ? (
                <Term term="current-cycle">Current cycle</Term>
              ) : (
                <Term term="backlog">Backlog</Term>
              )}
            </span>
            <span class="cycle-total">
              {ys.pipeline.reduce((sum, item) => sum + item.count, 0)} total
            </span>
          </div>
          <div class="stat-grid">
            {ys.pipeline.map((item) => (
              <div class={`stat-card ${statusClass(item.status)}`}>
                <span class="stat-num">{item.count}</span>
                <span class="stat-lbl">
                  <Term term={STATUS_TERMS[item.status] as TermSlug}>{item.label}</Term>
                </span>
              </div>
            ))}
          </div>
        </div>
      );
    })
  }
</div>
