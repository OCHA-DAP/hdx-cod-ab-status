---
import type { ScheduleGroup } from "../lib/loadData.ts";
import Term from "./Term.astro";
import WorkOrderTable from "./WorkOrderTable.astro";

interface Props {
  year: string;
  backlogCount: number;
  groups: ScheduleGroup[];
}

const { year, backlogCount, groups } = Astro.props;
---

<section>
  <h2>
    {year}
    <Term term="backlog">Backlog</Term>
    <span class={`count-chip ${backlogCount === 0 ? "done" : "warn"}`}>
      {backlogCount === 0 ? "All done" : `${backlogCount} remaining`}
    </span>
  </h2>
  <p class="section-desc">Incomplete work orders from the {year} cycle.</p>
  {
    backlogCount > 0 ? (
      <WorkOrderTable groups={groups} />
    ) : (
      <p class="empty">All {year} work orders are done.</p>
    )
  }
</section>
