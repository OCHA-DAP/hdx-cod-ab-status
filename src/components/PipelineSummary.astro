---
import type { PipelineCount } from "../lib/loadData.ts";
import { statusClass, STATUS_TERMS } from "../lib/status.ts";
import Term from "./Term.astro";
import type { TermSlug } from "../lib/glossary.ts";

interface Props {
  pipeline: PipelineCount[];
}

const { pipeline } = Astro.props;
const total = pipeline.reduce((sum, item) => sum + item.count, 0);
---

<style>
  .pipeline-card {
    border-radius: 3px;
    border: 1px solid #cccccc;
    padding: 1rem 1.25rem;
    background: #fff;
    margin-bottom: 1.25rem;
  }

  .pipeline-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .pipeline-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .pipeline-total {
    font-size: 12px;
    color: #888888;
    background: #eeeeee;
    border: 1px solid #cccccc;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  /* ── Stat cards ─────────────────────────────────────────────── */
  .stat-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stat-card {
    flex: 1 1 90px;
    border-radius: 3px;
    padding: 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border: 1px solid transparent;
  }

  .stat-num {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .stat-lbl {
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #444;
  }

  .stat-card.s-done {
    background: #c6efce;
    border-color: #93d09a;
  }
  .stat-card.s-in_progress {
    background: #fff2cc;
    border-color: #f5d262;
  }
  .stat-card.s-blocked {
    background: #fce4d6;
    border-color: #f4b183;
  }
  .stat-card.s-selected {
    background: #e0f2fe;
    border-color: #7dd3fc;
  }
  .stat-card.s-backlog {
    background: #f3f4f6;
    border-color: #d1d5db;
  }
  .stat-card.s-cancelled {
    background: #ffc7ce;
    border-color: #f09098;
  }
</style>

<div class="pipeline-card">
  <div class="pipeline-header">
    <span class="pipeline-title"><Term term="pipeline">Pipeline</Term></span>
    <span class="pipeline-total">{total} total</span>
  </div>
  <div class="stat-grid">
    {
      pipeline.map((item) => (
        <div class={`stat-card ${statusClass(item.status)}`}>
          <span class="stat-num">{item.count}</span>
          <span class="stat-lbl">
            <Term term={STATUS_TERMS[item.status] as TermSlug}>{item.label}</Term>
          </span>
        </div>
      ))
    }
  </div>
</div>
