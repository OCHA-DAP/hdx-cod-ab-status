---
import PipelineSummary from "../components/PipelineSummary.astro";
import WorkOrdersSection from "../components/WorkOrdersSection.astro";
import Layout from "../layouts/Layout.astro";
import { loadData } from "../lib/loadData.ts";

const data = loadData();
const remaining = data.workOrders.filter((r) => r.work_order_status !== "done").length;
const totalInGis = data.planGroups.reduce(
  (sum, g) => sum + g.countries.filter((c) => c.inGis).length,
  0,
);
const totalLocations = data.planGroups.reduce((sum, g) => sum + g.countries.length, 0);
const lastUpdatedFormatted = data.lastUpdatedAt
  ? new Date(data.lastUpdatedAt).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;
---

<Layout
  lastUpdatedFormatted={lastUpdatedFormatted}
  openTotal={data.openTotal}
  totalInGis={totalInGis}
  totalLocations={totalLocations}
>
  <PipelineSummary pipeline={data.pipeline} />

  <WorkOrdersSection workByQuarter={data.workByQuarter} remaining={remaining} />
</Layout>
